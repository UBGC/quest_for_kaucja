[gd_scene format=3]

[ext_resource type="Script" path="res://main_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://mainMenuLogoSprite.png" id="2_logo"]
[ext_resource type="Texture2D" path="res://level1BG.png" id="3_background"]

