content_margin_bottom = 12.0

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Backdrop" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("3_background")
expand_mode = 1
stretch_mode = 6

[node name="Tint" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.015686275, 0.047058824, 0.03137255, 0.72)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(460, 500)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Padding" type="MarginContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/margin_left = 34
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 34
theme_override_constants/margin_bottom = 30

[node name="Content" type="VBoxContainer" parent="Center/Card/Padding"]
layout_mode = 2
theme_override_constants/separation = 13

[node name="Logo" type="TextureRect" parent="Center/Card/Padding/Content"]
custom_minimum_size = Vector2(360, 64)
layout_mode = 2
texture = ExtResource("2_logo")
expand_mode = 1
stretch_mode = 5

[node name="Tagline" type="Label" parent="Center/Card/Padding/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7294118, 0.8352941, 0.6901961, 1)
theme_override_font_sizes/font_size = 16
text = "CLEAN STREETS. BIG ADVENTURES."
horizontal_alignment = 1

[node name="Separator" type="HSeparator" parent="Center/Card/Padding/Content"]
layout_mode = 2

[node name="Description" type="Label" parent="Center/Card/Padding/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.80784315, 0.85882354, 0.7764706, 1)
theme_override_font_sizes/font_size = 17
text = "Explore Gliwice. Catch bottles at the right moment."
horizontal_alignment = 1

[node name="PlayButton" type="Button" parent="Center/Card/Padding/Content"]
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
theme_override_colors/font_color = Color(0.9607843, 0.98039216, 0.9137255, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button_pressed")
text = "START YOUR QUEST"

[node name="ControlsButton" type="Button" parent="Center/Card/Padding/Content"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/font_color = Color(0.8862745, 0.9254902, 0.84705883, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button_pressed")
text = "HOW TO PLAY"

[node name="QuitButton" type="Button" parent="Center/Card/Padding/Content"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_colors/font_color = Color(0.8862745, 0.9254902, 0.84705883, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button_pressed")
text = "QUIT"

[node name="ControlsCenter" type="CenterContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="ControlsCenter"]
custom_minimum_size = Vector2(480, 360)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Padding" type="MarginContainer" parent="ControlsCenter/Card"]
layout_mode = 2
theme_override_constants/margin_left = 34
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 34
theme_override_constants/margin_bottom = 30

[node name="Content" type="VBoxContainer" parent="ControlsCenter/Card/Padding"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Heading" type="Label" parent="ControlsCenter/Card/Padding/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.81960785, 0.9490196, 0.6666667, 1)
theme_override_font_sizes/font_size = 26
text = "HOW TO PLAY"
horizontal_alignment = 1

[node name="Movement" type="Label" parent="ControlsCenter/Card/Padding/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8862745, 0.9254902, 0.84705883, 1)
theme_override_font_sizes/font_size = 18
text = "Move with W A S D or the arrow keys."
autowrap_mode = 2
horizontal_alignment = 1

[node name="Goal" type="Label" parent="ControlsCenter/Card/Padding/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8862745, 0.9254902, 0.84705883, 1)
theme_override_font_sizes/font_size = 18
text = "When a bottle is close, press E or SPACE when its changing deposit is positive."
autowrap_mode = 2
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="ControlsCenter/Card/Padding/Content"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
theme_override_colors/font_color = Color(0.9607843, 0.98039216, 0.9137255, 1)
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button_pressed")
text = "BACK TO MENU"

[connection signal="pressed" from="Center/Card/Padding/Content/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="Center/Card/Padding/Content/ControlsButton" to="." method="_on_controls_pressed"]
[connection signal="pressed" from="Center/Card/Padding/Content/QuitButton" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="ControlsCenter/Card/Padding/Content/BackButton" to="." method="_on_back_pressed"]
