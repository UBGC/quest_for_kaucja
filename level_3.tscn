[node name="LevelIntro" parent="." instance=ExtResource("6_intro")]
dialogue_title = "GLIWICE RADIO TOWER"
dialogue_text = "Completed in 1935, the wooden Gliwice Radio Tower became a landmark. On 31 August 1939, Nazi Germany staged a false-flag attack at the station and used it as a pretext for invading Poland. This is a place of remembrance; keep it clean and remember its history."

